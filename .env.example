# OpsPilot Main Application
DEEPSEEK_API_KEY=

# Teammate production simulator
# Local: http://localhost:3001
# Vercel: MUST be a public https URL of the deployed simulator — never localhost
SIMULATOR_URL=http://localhost:3001

# false = real simulator; true = local mock adapter
# On Vercel use false only when SIMULATOR_URL is publicly reachable
USE_MOCK_SIMULATOR=false

# Supabase (server persistence)
# URL may be public; the service-role key is SERVER ONLY — never put it in NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: force storage driver ("supabase" | "memory"). Default: supabase when both vars are set.
# STORAGE_DRIVER=memory
